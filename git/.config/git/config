[user]
    name = André Kanakis
    email = andre@kanak.is

[commit]
    template = ~/.config/git/template

[core]
    compression = 9
    editor = nvim

[diff]
    context = 3

[init]
    defaultBranch = main

[log]
    abbrevCommit = false
    graphColors = blue,yellow,cyan,magenta,green,red

[status]
    branch = true
    ; short = true
    ; showStash = true
    showUntrackedFiles = all

[push]
    autoSetupRemote = true
    default = current

[pull]
    rebase = true

[rebase]
    autoStash = true

# URLs
[url "git@github.com:"]
    insteadOf = "gh:"

[url "git@github.com:andrekanakis/"]
    insteadOf = "ak:"
